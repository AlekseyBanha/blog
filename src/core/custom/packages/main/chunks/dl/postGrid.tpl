<div class="col-lg-6">
  <div class="blog-post">
    <div class="blog-thumb">
      <a href="[+url+]"><img src="[+tv.image+]" alt="[+pagetitle+]"></a>
    </div>
    <div class="down-content">
      <span>[+tv.category+]</span>
      <a href="[+url+]"><h4>[+pagetitle+]</h4></a>
      <ul class="post-info">
        <li>Екскурсовод</li>
        <li>[+date+]</li>
        <li><i class="fa fa-eye"></i> [+tv.views+]</li>
      </ul>
      <p>[+introtext+]</p>
      <div class="post-options">
        <div class="row">
          <div class="col-lg-12">
            <ul class="post-tags">
              <li><i class="fa fa-tags"></i></li>
              [+tags_html+]
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
