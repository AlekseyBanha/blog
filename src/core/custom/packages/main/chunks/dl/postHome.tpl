<div class="col-lg-12">
  <div class="blog-post">
    <div class="blog-thumb">
      <a href="[+url+]"><img src="[+tv.image+]" alt="[+pagetitle+]"></a>
    </div>
    <div class="down-content">
      <span>[+tv.category+]</span>
      <a href="[+url+]"><h4>[+pagetitle+]</h4></a>
      <ul class="post-info">
        <li>Екскурсовод</li>
        <li>[+date+]</li>
      </ul>
      <p>[+introtext:nl2br+]</p>
      <div class="post-options">
        <div class="row">
          <div class="col-6">
            <ul class="post-tags">
              <li><i class="fa fa-tags"></i></li>
              [+tags_html+]
            </ul>
          </div>
          <div class="col-6">
            <ul class="post-share">
              <li><i class="fa fa-share-alt"></i></li>
              <li><a href="https://www.facebook.com/ukraine_forever" target="_blank" rel="noopener noreferrer">Facebook</a>,</li>
              <li><a href="https://x.com/ukraine_forever" target="_blank" rel="noopener noreferrer"> Twitter</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
